# Copy this file to .env for local scripts or configure these in GitHub Actions Secrets
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password # only for local `supabase db push`
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# The household invite code is deliberately NOT configured here or in CI: the IPA is published
# publicly, so anything built into it is public. Read the code from the database
# (select name, invite_code from public.households;) and type it into Settings on each phone.
