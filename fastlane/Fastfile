default_platform(:ios)

platform :ios do
  desc "Optional future lane if upgraded to paid $99/yr Apple Developer Program for TestFlight"
  lane :beta do
    sh("cd ../ios && xcodegen generate")
    build_app(
      project: "ios/Reshima.xcodeproj",
      scheme: "Reshima",
      export_method: "app-store"
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
