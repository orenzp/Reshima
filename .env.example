# Copy this file to .env for local scripts or configure these in GitHub Actions Secrets
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# Optional: Default shared household invite code for auto-joining
DEFAULT_HOUSEHOLD_CODE=RESHIMA-HOME
